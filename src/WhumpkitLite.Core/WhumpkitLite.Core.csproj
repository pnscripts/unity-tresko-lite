<Project Sdk="Microsoft.NET.Sdk">
  <!-- Plain C# core of Whumpkit Lite (no UnityEngine references). The same files are copied into the
       Unity package (Runtime/Core) by build.py. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>PNScripts.WhumpkitLite</RootNamespace>
    <AssemblyName>PNScripts.WhumpkitLite.Core</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Authors>PN Scripts</Authors>
    <Company>ПН СКРИПТС ЕООД / PN Scripts</Company>
    <Copyright>Copyright (c) 2026 ПН СКРИПТС ЕООД / PN Scripts</Copyright>
    <Version>2.0.0</Version>
  </PropertyGroup>
</Project>
